# AI_API_KEY is provider-neutral and takes precedence. OPENCODE_API_KEY is the
# fallback used with the default OpenCode endpoint.
AI_API_KEY=
OPENCODE_API_KEY=

# Override the OpenAI-compatible provider endpoint when needed.
AI_BASE_URL=https://opencode.ai/zen/v1

# The reviewer model, on the same endpoint. Leave empty for manual review only.
NEXT_PUBLIC_AI_REVIEWER_MODEL=
