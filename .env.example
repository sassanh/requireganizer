# No API key is required for the free OpenCode Zen models (deepseek-v4-flash-free).
# AI_API_KEY is the provider-neutral setting. When it is unset, the harness
# uses OPENCODE_API_KEY.
AI_API_KEY=
OPENCODE_API_KEY=

# Override the OpenAI-compatible provider, model, or request timeout when needed.
AI_BASE_URL=https://opencode.ai/zen/v1
AI_MODEL=deepseek-v4-flash-free
AI_REQUEST_TIMEOUT_MS=60000
