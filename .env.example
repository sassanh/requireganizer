# Read by the project server (requireganizer, pnpm run dev) when it starts.

# Bearer token for the AI endpoint.
AI_API_KEY=

# An OpenAI-compatible Responses API, and the models on it.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# The reviewer model, on the same endpoint. Leave empty for manual review only.
AI_REVIEWER_MODEL=
