{
  "name": "requireganizer",
  "version": "0.1.0",
  "private": true,
  "description": "Turn a one-line idea into requirements, contracts and tests you approve item by item, then give your coding agent the spec to build against, over MCP.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sassanh/requireganizer.git"
  },
  "homepage": "https://sassanh.github.io/requireganizer/",
  "c8": {
    "exclude": [
      "tests/**",
      ".test-dist/tests/**",
      "docs/**"
    ]
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "requireganizer": "dist/requireganizer.mjs"
  },
  "scripts": {
    "dev": "node scripts/build-server.mjs --dev && node .server-dist/dev.mjs",
    "dev:browser": "next dev",
    "build": "next build",
    "server:build": "node scripts/build-server.mjs",
    "server:start": "node dist/requireganizer.mjs",
    "package:check": "node scripts/check-package.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "prepare": "cp .husky/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit || true",
    "coverage": "c8 --reporter=text-summary --reporter=html --reporter=lcov node scripts/run-tests.mjs",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run server:build && pnpm run package:check && pnpm run docs:build",
    "cf:deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/lab": "9.0.0-beta.8",
    "@mui/material": "^9.3.1",
    "@mui/material-nextjs": "^9.3.0",
    "@mui/system": "^9.3.0",
    "@noble/hashes": "2.0.1",
    "@react-pdf/renderer": "^4.6.0",
    "@types/file-saver": "^2.0.7",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "clsx": "^2.1.1",
    "compressjs": "^1.0.3",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "mobx": "^6.16.1",
    "mobx-react-lite": "^4.1.1",
    "mobx-state-tree": "^7.3.2",
    "next": "^16",
    "openai": "^7.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-textarea-autosize": "^8.5.9",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "uuid": "^14.0.1",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16",
    "@types/ws": "^8.18.2",
    "c8": "^12.0.0",
    "esbuild": "0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16",
    "eslint-plugin-etc": "^2.0.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.11.6",
    "typescript": "5.9.3",
    "vitepress": "1.6.4",
    "wrangler": "^4.120.1"
  }
}
